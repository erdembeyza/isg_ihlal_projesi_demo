# Backend ortam degiskenleri (Spring Boot).
# Kopyala: copy .env.example .env  (veya dogrudan shell/IDE env olarak set et)
# application.yml bu degerleri okur; .env dosyasi otomatik yuklenmez —
# IDE run config, sistem env veya Docker Compose ile saglanmalidir.

# PostgreSQL (docker-compose.yml ile uyumlu varsayilanlar)
DB_URL=jdbc:postgresql://localhost:5432/isg_ihlal_db
DB_USERNAME=isg_admin
DB_PASSWORD=isg_admin_pw

# JWT — PROD'da mutlaka degistirin (Base64, HMAC-SHA256 icin yeterli uzunlukta)
JWT_SECRET=bXktc3VwZXItc2VjcmV0LWtleS1mb3ItaXNnLWlobGFsLXByb2plc2ktZGV2LW9ubHktY2hhbmdlLWluLXByb2Q=
JWT_EXPIRATION_MS=3600000

# Kanit fotograflari (orijinal/blurlu) ve fine-tune havuzu kok dizini
UPLOAD_DIR=uploads

# HTTP
SERVER_PORT=8080

# CORS — virgulle ayirilmis origin listesi (Angular ng serve varsayilani)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Kamera heartbeat: bu sureden eski guncelleme = offline
KAMERA_OFFLINE_SANIYE=30

# Telegram bildirim (MVP). Token/chat yoksa veya TELEGRAM_ENABLED=false ise sessizce atlanir.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Haftalik rapor Telegram mesajindaki PDF linki icin
PUBLIC_BASE_URL=http://localhost:8080
