# Backend API adresi (Java Spring Boot) - sonuna /api eklenmez, kod icinde
# /api/auth/login ve /api/ihlaller olarak birlestirilir.
BACKEND_BASE_URL=http://localhost:8080

# AI Core'un backend'e giris yapacagi servis hesabi (bkz. backend
# V4__ai_core_servis_hesabi.sql migration'i). Sadece dev/test icindir.
AI_CORE_KULLANICI_ADI=ai_core_servis
AI_CORE_SIFRE=AiCore123!

# Video kaynağı: RTSP URL (ör. rtsp://kamera-ip:554/stream) veya test için
# yerel video dosya yolu (ai-core kok dizinine gore bagil ya da mutlak).
VIDEO_SOURCE=test_videos/ornek_video.mp4

# Kullanılacak YOLO ağırlık dosyası (PPE/hardhat modeli). Bu dosya
# bulunamazsa AI Core, ultralytics'in COCO uzerinde on-egitilmis genel
# yolov8n.pt modeline duser ve yalnizca "person" sinifiyla calisan bir
# DEMO_MODU'na gecer (bkz. ai-core/README.md).
YOLO_MODEL_PATH=models/ppe_yolov8n.pt

# Tespit güven eşiği (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.5

# İlgili bölge kimliği (bolgeler.id) - bu AI Core surecinin izledigi
# kameranin/bolgenin kimligi. Her bolge/kamera icin ayri bir surec calisir.
BOLGE_ID=1

# ihlal_tipleri tablosundaki sabit kimlikler (V2__seed.sql ekleme sirasi:
# BARET=1, YELEK=2, GOZLUK=3). Semaya baret/yelek/gozluk disinda yeni bir
# ihlal tipi eklenirse burada guncellenmelidir.
IHLAL_TIPI_ID_BARET=1
IHLAL_TIPI_ID_YELEK=2
IHLAL_TIPI_ID_GOZLUK=3

# Ayni ihlal tipi icin ardisik bildirimler arasindaki minimum bekleme
# suresi (saniye). Kamera FPS'i kadar sik POST atilmasini (spam) engeller.
DETECTION_COOLDOWN_SANIYE=30

# Performans icin YOLO cikarimi her karede degil, N karede bir calistirilir
# (ör. 2 = her 2 karede bir). Kare okuma yine her dongude yapilir.
FRAME_ATLAMA=2
