# Backend API adresi (Java Spring Boot)
BACKEND_API_URL=http://localhost:8080/api/ihlaller

# Video kaynağı: RTSP URL veya test i\u00e7in yerel video dosya yolu
VIDEO_SOURCE=test_videos/ornek_video.mp4

# Kullanılacak YOLO ağırlık dosyası (PPE/hardhat modeli)
YOLO_MODEL_PATH=models/ppe_yolov8n.pt

# Tespit güven eşiği (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.5

# İlgili bölge kimliği (bolgeler.id) - test amaçlı sabit
BOLGE_ID=1
