# ============================================================================
# AI Core — canli izleme ayarlari
# Kopyala: copy .env.example .env
# ============================================================================

BACKEND_BASE_URL=http://localhost:8080

AI_CORE_KULLANICI_ADI=ai_core_servis
AI_CORE_SIFRE=AiCore123!

# ---------------------------------------------------------------------------
# VIDEO_SOURCE secenekleri:
#   0          -> bilgisayar webkami (gelistirme; guvenlik kamerasi gibi surekli)
#   webcam     -> ayni (alias)
#   rtsp://... -> gercek guvenlik kamerasi
#   test_videos/demo2.mp4 -> dosya (surekli icin: python -m src.main --loop)
# ---------------------------------------------------------------------------
VIDEO_SOURCE=0
BOLGE_ID=1
KAMERA_ADI=Veri Merkezi guvenlik kamerasi

YOLO_MODEL_PATH=models/ppe_yolov8n.pt
CONFIDENCE_THRESHOLD=0.5

IHLAL_TIPI_ID_BARET=1
IHLAL_TIPI_ID_YELEK=2
IHLAL_TIPI_ID_GOZLUK=3

# Ayni tip icin tekrar foto/kayit araligi (saniye). Video dongusunde spam olmasin.
DETECTION_COOLDOWN_SANIYE=30
# 1 = her karede YOLO (daha hizli tespit). 2+ = performans icin atlama.
FRAME_ATLAMA=2

# IoU tracker: ihlal bu sure boyunca surerse backend'e TEK kayit acilir.
# Dusuk deger = cok fazla foto + DB yuku. Oneri: 8-15.
IHLAL_MIN_SURE_SANIYE=8
# Kamera online durumu icin backend heartbeat araligi
HEARTBEAT_SANIYE=5

STREAM_YENIDEN_BAGLAN_SANIYE=5
STREAM_MAX_YENIDEN_BAGLANMA=-1
STREAM_BUFFER_SIZE=1
STREAM_RTSP_TCP=true
